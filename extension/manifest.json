{
  "manifest_version": 3,
  "name": "MailPolish AI Beta",
  "version": "0.2.0",
  "description": "One-click professional email rewrites inside Gmail.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mailpolish-ai-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}